{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Vulkan Triangle",
            "type": "shell",
            "command": "cmake -S \"${workspaceFolder}\" -B \"${workspaceFolder}/build-local\" && cmake --build \"${workspaceFolder}/build-local\" --parallel",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Run Vulkan Triangle",
            "type": "shell",
            "command": "\"${workspaceFolder}/build-local/vulkan_triangle\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build Vulkan Triangle",
            "problemMatcher": []
        },
        {
            "label": "C/C++: g++ build active file",
            "dependsOn": "Build Vulkan Triangle",
            "problemMatcher": []
        }
    ]
}